# Apache HugeGraph (benchmark candidate #1 per ADR-086)
#
# HugeGraph needs a backend (HBase or RocksDB). The official all-in-one
# image includes HugeGraphServer + RocksDB backend for single-node benchmarking.
#
# Ports:
#   8080 — Gremlin HTTP (main API)
#   8090 — HugeStudio (optional, web UI)
#   8081 — HBase (embedded, single-node only)
#
# Health check: GET /graphs/hugegraph
#
# Usage:
#   podman build -t golem-hugegraph:latest .
#   podman run -d --name golem-hugegraph -p 8080:8080 -p 8090:8090 -p 8081:8081 golem-hugegraph:latest

FROM docker.io/hugegraph/hugegraph:latest

EXPOSE 8080 8090 8081

# Fix: bind the HugeGraph graph to the Gremlin traversal source 'g'.
# The official image ships with graphs: {} (empty), so 'g' is not bound.
#
# Two fixes applied:
# 1. gremlin-server.yaml — loads hugegraph-init.groovy instead of empty-sample.groovy
# 2. hugegraph-init.groovy — opens the graph and binds it to 'g'
COPY gremlin-server.yaml /hugegraph-server/conf/gremlin-server.yaml
COPY hugegraph-init.groovy /hugegraph-server/scripts/hugegraph-init.groovy
