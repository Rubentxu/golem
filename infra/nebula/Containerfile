# NebulaGraph all-in-one — benchmark candidate #2 (ADR-086)
#
# Bundle all three NebulaGraph services (metad + storaged + graphd)
# into a single container for single-node benchmark.
#
# Ports exposed:
#   9669  — nGQL client (graphd)
#   19669 — HTTP console
#   9559  — metad thrift
#   9560  — storaged thrift
#
# Usage:
#   docker compose up -d nebula-allinone

FROM docker.io/vesoft/nebula-graphd:latest

# metad and storaged binaries come from the full NebulaGraph distribution.
# Pull from the metad image and copy only the binaries we need.
COPY --from=docker.io/vesoft/nebula-metad:latest /usr/local/nebula/bin/nebula-metad /usr/local/nebula/bin/
COPY --from=docker.io/vesoft/nebula-storaged:latest /usr/local/nebula/bin/nebula-storaged /usr/local/nebula/bin/

# Entrypoint starts all three services in sequence
ENTRYPOINT ["/bin/bash", "-c", "\
    echo 'Starting metad...' && \
    /usr/local/nebula/bin/nebula-metad --flagfile=/usr/local/nebula/nebula-metad.conf --meta_server_addrs=127.0.0.1:9559 --local_config=true & \
    sleep 3 && \
    echo 'Starting storaged...' && \
    /usr/local/nebula/bin/nebula-storaged --flagfile=/usr/local/nebula/nebula-storaged.conf --meta_server_addrs=127.0.0.1:9559 --local_config=true & \
    sleep 3 && \
    echo 'Starting graphd...' && \
    /usr/local/nebula/bin/nebula-graphd --flagfile=/usr/local/nebula/nebula-graphd.conf --meta_server_addrs=127.0.0.1:9559 --local_config=true & \
    echo 'All services started.' && \
    wait"]
