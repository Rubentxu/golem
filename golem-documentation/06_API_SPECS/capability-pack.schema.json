{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golem.dev/schemas/capability-pack.v1.json",
  "title": "GOLEM Capability Pack Manifest v1",
  "type": "object",
  "required": [
    "name",
    "version",
    "golem_api",
    "capabilities",
    "entrypoints"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "golem_api": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoints": {
      "type": "object",
      "properties": {
        "wasm": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remote": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "budgets": {
      "type": "object"
    },
    "ontology": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
