{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://golem.dev/schemas/event-envelope.v1.json",
  "title": "GOLEM Event Envelope v1",
  "type": "object",
  "required": [
    "event_id",
    "tenant_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "actor",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "stream_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+\\.v[0-9]+$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "service",
            "agent"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "command_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "frame_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
